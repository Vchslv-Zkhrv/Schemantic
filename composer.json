{
    "name": "schemantic/schemantic",
    "type": "library",
    "description": "Smart PHP structures",
    "keywords": [
        "schema",
        "parser",
        "ORM",
        "structure",
        "dto",
        "validation",
        "parsing",
        "JSON"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1 || ^8.5"
    },
    "autoload": {
        "psr-4": {
            "Schemantic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schemantic\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2",
        "squizlabs/php_codesniffer": "^3.11",
        "phpstan/phpstan": "^2.1"
    }
}
